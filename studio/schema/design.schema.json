{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/verbalogicproject-creator/L.S.Design/studio/schema/design.schema.json",
  "title": "L.S.Design studio design.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 2
        },
        "dir": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "name",
        "slug",
        "root",
        "lang",
        "dir",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "direction",
        "screens",
        "approved",
        "built"
      ]
    },
    "tokensHash": {
      "type": "string"
    },
    "contrastPairs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "foreground": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "target": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "foreground",
          "background",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "stitch",
            "agent",
            "import"
          ]
        },
        "stitch": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "designSystemId": {
              "type": "string"
            }
          },
          "required": [
            "projectId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "screens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scr_[0-9a-f]{8}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "tablet",
              "mobile"
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "stitch",
                  "agent",
                  "import"
                ]
              },
              "projectId": {
                "type": "string"
              },
              "screenId": {
                "type": "string"
              },
              "instanceId": {
                "type": "string"
              },
              "sourceScreen": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "refPath": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "parentId": {
            "type": "string",
            "pattern": "^scr_[0-9a-f]{8}$"
          },
          "files": {
            "type": "object",
            "properties": {
              "html": {
                "type": "string"
              },
              "png": {
                "type": "string"
              },
              "sha256": {
                "type": "object",
                "properties": {
                  "html": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "png": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "html",
                  "png"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "html",
              "png",
              "sha256"
            ],
            "additionalProperties": false
          },
          "decision": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "notes": {
                "default": "",
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "by": {
                "type": "string",
                "enum": [
                  "human",
                  "agent"
                ]
              }
            },
            "required": [
              "state",
              "notes"
            ],
            "additionalProperties": false
          },
          "tokenDriven": {
            "default": false,
            "type": "boolean"
          },
          "staleTokens": {
            "default": false,
            "type": "boolean"
          },
          "capturedTokensHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canvas": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "device",
          "width",
          "height",
          "source",
          "revision",
          "files",
          "decision",
          "tokenDriven",
          "staleTokens",
          "canvas"
        ],
        "additionalProperties": false
      }
    },
    "requests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{8}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "regenerate",
              "variants",
              "edit_with_prompt",
              "add_screen",
              "reapply_design_system"
            ]
          },
          "screenId": {
            "type": "string",
            "pattern": "^scr_[0-9a-f]{8}$"
          },
          "payload": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "claimed",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "claimedBy": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "result": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "type",
          "payload",
          "state",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "type": {
            "type": "string"
          },
          "data": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "seq",
          "at",
          "type",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "screens": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "handoffSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "passed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "screens"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "screenId": {
            "type": "string",
            "pattern": "^scr_[0-9a-f]{8}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "notes": {
            "default": "",
            "type": "string"
          },
          "by": {
            "type": "string",
            "enum": [
              "human",
              "agent"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "at",
          "state",
          "notes",
          "by"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "rev",
    "seq",
    "project",
    "status",
    "tokensHash",
    "contrastPairs",
    "generator",
    "screens",
    "requests",
    "events",
    "gates",
    "approvals",
    "provenance"
  ],
  "additionalProperties": false
}
